# Project Veronica — Environment Configuration Template
# Copy this file to .env and fill in your own API keys.
# Never commit .env or real keys to version control!

# Primary Cloud Intelligence Providers (at least one recommended; Gemini Flash or Groq recommended for ultra-low latency)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Local LLM Provider (Ollama)
OLLAMA_URL=http://127.0.0.1:11434

# Optional Local Smart Home / IoT Integration (RFC1918 Private LAN Only)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_home_assistant_long_lived_token_here

# Loopback Voice Service Port
VERONICA_PORT=8765
